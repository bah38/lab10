def buildCommand(String command) {
    if (isUnix()) {
        sh command
    } else {
        bat command
    }
}

pipeline {
    agent any

    options {
        disableConcurrentBuilds()
    }

    stages {
        stage('Setup') {
            steps {
                script {
                    buildCommand(isUnix() ? 'python3 -m venv venv' : 'python -m venv venv')
                    env.VENV_PYTHON = isUnix() ? 'venv/bin/python' : 'venv\\Scripts\\python.exe'
                    buildCommand("${env.VENV_PYTHON} -m pip install -r requirements.txt")
                }
            }
        }

        stage('Lint') {
            steps {
                script {
                    buildCommand("${env.VENV_PYTHON} -m flake8 --jobs=1 app.py deploy.py tests")
                }
            }
        }

        stage('Test') {
            steps {
                script {
                    buildCommand("${env.VENV_PYTHON} -m pytest --junitxml=test-results.xml")
                }
            }
            post {
                always {
                    junit 'test-results.xml'
                }
            }
        }

        stage('Coverage') {
            steps {
                script {
                    buildCommand("${env.VENV_PYTHON} -m coverage run --branch --include=app.py -m pytest")
                    buildCommand("${env.VENV_PYTHON} -m coverage report -m")
                    buildCommand("${env.VENV_PYTHON} -m coverage xml -o coverage.xml")
                }
                archiveArtifacts artifacts: 'coverage.xml'
            }
        }

        stage('Security Scan') {
            steps {
                script {
                    buildCommand("${env.VENV_PYTHON} -m bandit -f json -o bandit.json app.py deploy.py")
                }
            }
            post {
                always {
                    archiveArtifacts artifacts: 'bandit.json'
                }
            }
        }

        stage('Deploy') {
            steps {
                script {
                    buildCommand("${env.VENV_PYTHON} deploy.py")
                }
            }
        }
    }

    post {
        always {
            cleanWs()
        }
    }
}
